{
  "name": "nature-nook",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/build-markdown.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:agents": "node tests/agent-readiness.mjs",
    "test:guest-guide": "node --test tests/guide/*.test.mjs",
    "test:guest-map": "playwright test",
    "preview:worker": "wrangler dev --ip 0.0.0.0 --port 8801",
    "test": "node tests/worker.mjs && node tests/seo.mjs && node tests/distances.mjs && node --test tests/guide/*.test.mjs && node tests/booking-reviews.mjs",
    "test:guide": "playwright test",
    "build:brochure": "npm run build && node scripts/build-guest-brochure.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "leaflet": "^1.9.4",
    "linkedom": "^0.18.13",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.4",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1",
    "typescript": "5.9.2",
    "wrangler": "^4.158.0"
  }
}
