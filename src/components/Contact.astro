---
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
import EnquiryForm from './EnquiryForm.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="booking-cta tw:scroll-mt-24" id="enquiry">
  <div class="tw:mx-auto tw:max-w-6xl tw:lg:grid tw:lg:grid-cols-[0.8fr_1.2fr] tw:lg:gap-16 tw:lg:text-left">
    <div>
      <p class="eyebrow">{t('holidayStarts')}</p>
      <h2>{t('enquiryTitle')}</h2>
      <p class="tw:mx-auto tw:mt-5 tw:max-w-xl tw:text-lg tw:leading-relaxed tw:lg:mx-0">{t('enquiryIntro')}</p>
    </div>
    <EnquiryForm {locale} />
  </div>
</section>
