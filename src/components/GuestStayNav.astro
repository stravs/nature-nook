---
import type { Locale } from '../i18n';
interface Props { locale: Locale; sections: string[][] }
const { locale, sections } = Astro.props;
const en = locale === 'en';
const hints = en
  ? ['Find us & settle in', 'Rooms & sleeping arrangements', 'What’s here for you', 'A few friendly requests', 'Before you leave', 'Host, taxis & useful numbers']
  : ['Pot do nas in prihod', 'Sobe in razporeditev ležišč', 'Kaj vas čaka pri nas', 'Nekaj prijaznih prošenj', 'Pred odhodom', 'Gostitelj, taksi in uporabne številke'];
---
<nav class="stay-contents" aria-label={en ? 'Find information for your stay' : 'Poiščite informacije za bivanje'}>
  {sections.filter(([id]) => id !== 'explore').map(([id, label], index) => <a href={`#${id}`}><span><strong>{label}</strong><small>{hints[index]}</small></span><span aria-hidden="true">↗</span></a>)}
</nav>
<style>
  .stay-contents{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--line);border-radius:10px;overflow:hidden;margin:0 0 14px;background:var(--paper)}
  .stay-contents a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px;min-height:90px;text-decoration:none;border-bottom:1px solid var(--line)}
  .stay-contents a:not(:nth-child(3n)){border-right:1px solid var(--line)}
  .stay-contents a:nth-last-child(-n+3){border-bottom:0}
  .stay-contents strong{display:block;font-size:.85rem;font-weight:700;color:var(--ink)}
  .stay-contents small{display:block;font-size:.68rem;line-height:1.5;color:var(--muted);margin-top:4px}
  .stay-contents a>span:last-child{color:var(--clay);font-size:1rem}
  .stay-contents a:hover{background:var(--soft)}
  .stay-contents a:focus-visible{outline:3px solid var(--clay);outline-offset:-4px}
  @media(max-width:600px){.stay-contents{grid-template-columns:1fr 1fr}.stay-contents a{padding:16px;min-height:84px}.stay-contents a:not(:nth-child(3n)){border-right:0}.stay-contents a:nth-last-child(-n+3){border-bottom:1px solid var(--line)}.stay-contents a:nth-child(odd){border-right:1px solid var(--line)}.stay-contents a:nth-last-child(-n+2){border-bottom:0}.stay-contents strong{font-size:.8rem}.stay-contents small{font-size:.65rem}}
</style>
