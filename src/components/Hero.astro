---
import PropertyImage from './PropertyImage.astro';
import BookingReviews from './BookingReviews.astro';
import type { Property } from '../domain/property';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';

interface Props { property: Property; locale: Locale }
const { property, locale } = Astro.props;
const t = useTranslations(locale);
const hero = property.photos[0];
---
<section class:list={["hero", { "hero--empty": !hero }]} aria-labelledby="property-title">
  {hero ? <div class="hero-photo tw:relative tw:overflow-hidden tw:[&>img]:absolute tw:[&>img]:inset-0 tw:[&>img]:size-full tw:[&>img]:object-cover tw:[&>img]:-rotate-1 tw:[&>img]:scale-[1.04]"><PropertyImage photo={hero} alt={hero.alt ?? property.name} sizes="100vw" priority /></div> : <div class="image-empty">{t('propertyPhoto')}</div>}
  <div class="hero-card">
    <p class="eyebrow">{property.type ?? t('accommodation')} · {property.city}</p>
    <h1 id="property-title">{property.name}</h1>
    <p>{property.description}</p>
    <a class="primary-button" href="#enquiry">{t('reserve')}</a>
    <BookingReviews {property} {locale} compact />
  </div>
</section>
