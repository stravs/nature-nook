---
import type { Property } from '../domain/property';
import { propertyLocation } from '../domain/property';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
interface Props { property: Property; locale: Locale }
const { property, locale } = Astro.props;
const t = useTranslations(locale);
const location = propertyLocation(property);
const mapUrl = property.latitude !== undefined && property.longitude !== undefined ? `https://www.google.com/maps?q=${property.latitude},${property.longitude}&z=16&output=embed` : undefined;
---
{location && <section class="section location" id="location">
  <div><p class="eyebrow">{t('location')}</p><h2>{property.city ?? property.country}</h2><p class="lead">{location}</p><p>{t('locationCopy')}</p></div>
  {mapUrl ? <iframe src={mapUrl} title={`${t('mapOf')} ${property.name}`} loading="lazy"></iframe> : <div class="map-fallback">{location}</div>}
</section>}
