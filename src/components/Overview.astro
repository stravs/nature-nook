---
import type { Property } from '../domain/property';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';

interface Props { property: Property; locale: Locale }
const { property, locale } = Astro.props;
const t = useTranslations(locale);
const unit = property.units.length === 1 ? property.units[0] : undefined;
const amenities = [...property.amenities, ...(unit?.amenities ?? [])];
const hasWifi = amenities.some((amenity) => /wi[\s-]?fi|wireless|brezžič/i.test(amenity));
const hasParking = amenities.some((amenity) => /parking|parkirišč/i.test(amenity));
const facts = [
  unit?.maxGuests ? { text: t('guests', { count: unit.maxGuests }), amenity: false } : undefined,
  unit?.bedrooms ? { text: t('bedrooms', { count: unit.bedrooms }), amenity: false } : undefined,
  unit?.areaSquareMetres ? { text: `${unit.areaSquareMetres} m²`, amenity: false } : undefined,
  hasParking ? { text: t('parking'), amenity: true } : undefined,
  hasWifi ? { text: 'Wi-Fi', amenity: true } : undefined,
].filter((fact): fact is { text: string; amenity: boolean } => Boolean(fact));
---
{facts.length > 0 && <section class="facts" aria-label={t('propertyOverview')}>
  {facts.map((fact) => <span class:list={{ 'fact-amenity': fact.amenity }}>{fact.text}</span>)}
</section>}
