---
import type { Property } from '../domain/property';
import type { SiteConfig, SectionId } from '../config/site';
import type { Locale } from '../i18n';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Overview from './Overview.astro';
import Intro from './Intro.astro';
import Units from './Units.astro';
import UnitLightbox from './UnitLightbox.astro';
import Stay from './Stay.astro';
import Amenities from './Amenities.astro';
import Location from './Location.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';

interface Props { property: Property; config: SiteConfig; locale: Locale }
const { property, config, locale } = Astro.props;
const enabled = (section: SectionId) => config.sections.includes(section);
const combinedStay = enabled('units') && property.units.length === 1;
const personalContact = config.contact.type === 'personal' || config.contact.type === 'both';
const bookingContact = config.contact.type === 'booking' || config.contact.type === 'both';
const galleryUnits = property.units.length === 1 ? property.units.map((unit) => {
  const photos = [...property.photos, ...unit.photos].filter((photo, index, all) => all.findIndex((candidate) => candidate.url === photo.url) === index);
  return { ...unit, photos };
}) : property.units;
const galleryProperty = { ...property, units: galleryUnits };
const designStyle = `--ink:${config.design.colors.text};--muted:${config.design.colors.muted};--paper:${config.design.colors.background};--soft:${config.design.colors.surface};--cream:${config.design.colors.surface};--moss:${config.design.colors.primary};--clay:${config.design.colors.accent};--font-display:var(--astro-font-heading),Georgia,serif;--font-body:var(--astro-font-body),system-ui,sans-serif`;
---
<div data-site-slug={config.site.slug} data-edges={config.design.edges} data-gallery={config.design.gallery} data-hero={config.design.hero} data-units={config.design.units} data-amenities={config.design.amenities} data-contact={config.design.contact} style={designStyle}>
  <Header {property} {config} {locale} />
  <main>
    <Hero {property} {locale} />
    <Overview {property} {locale} />
    {enabled('intro') && <Intro {property} {locale} />}
    {enabled('units') && galleryProperty.units.length > 0 && <Units property={galleryProperty} {locale} />}
    <UnitLightbox units={galleryUnits} {locale} />
    {combinedStay && <Stay {property} {locale} includeAmenities={enabled('amenities')} />}
    {!combinedStay && enabled('amenities') && property.amenities.length > 0 && <Amenities amenities={property.amenities} {locale} />}
    {enabled('location') && <Location {property} {locale} />}
    {enabled('contact') && <Contact {property} {locale} {personalContact} {bookingContact} />}
  </main>
  <Footer {property} />
</div>
