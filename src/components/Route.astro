---
import { fullPhoto } from '../lib/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import Page from './Page.astro';
import { localizeProperty, propertyMetaDescription, propertyLocation } from '../domain/property';
import { propertyRepository } from '../repositories/property-repository';
import { getSiteConfig } from '../config/site';
import type { Locale } from '../i18n';
import { localePath, useTranslations } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const sourceProperty = await propertyRepository.get();
if (!sourceProperty) return Astro.redirect('/setup');
const property = localizeProperty(sourceProperty, locale);
const t = useTranslations(locale);
const siteConfig = await getSiteConfig();
const description = propertyMetaDescription(property);
const canonical = new URL(localePath(locale), Astro.site ?? Astro.url.origin).href;
const title = `${property.name} | ${property.type ?? t('homeTitleFallback')}${property.city ? ` · ${property.city}` : ''}`;
const allPhotos = [...property.photos, ...property.units.flatMap((unit) => unit.photos)]
  .filter((photo, index, photos) => photos.findIndex((item) => item.url === photo.url) === index);
const imageUrls = new Map(await Promise.all(allPhotos.map(async (photo) => [
  photo.url, new URL((await fullPhoto(photo.url)).src, Astro.site ?? Astro.url.origin).href,
] as const)));
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'LodgingBusiness', name: property.name,
  '@id': new URL('/#lodging', Astro.site ?? Astro.url.origin).href,
  amenityFeature: property.amenities.map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
  description: property.description, url: canonical, image: allPhotos.map((photo) => imageUrls.get(photo.url)),
  address: { '@type': 'PostalAddress', streetAddress: property.address, addressLocality: property.city, addressCountry: property.country },
  geo: property.latitude !== undefined && property.longitude !== undefined ? { '@type': 'GeoCoordinates', latitude: property.latitude, longitude: property.longitude } : undefined,
  aggregateRating: property.rating && property.reviewCount ? { '@type': 'AggregateRating', ratingValue: property.rating, reviewCount: property.reviewCount, bestRating: 10 } : undefined,
  sameAs: property.bookingUrl, knowsLanguage: ['sl', 'en'], slogan: propertyLocation(property),
  containsPlace: property.units.map((unit) => ({ '@type': 'Accommodation', name: unit.name, description: unit.description, image: unit.photos.map((photo) => imageUrls.get(photo.url)), occupancy: unit.maxGuests ? { '@type': 'QuantitativeValue', maxValue: unit.maxGuests } : undefined, floorSize: unit.areaSquareMetres ? { '@type': 'QuantitativeValue', value: unit.areaSquareMetres, unitCode: 'MTK' } : undefined })),
};
---
<BaseLayout {title} siteName={property.name} imageAlt={property.photos[0]?.alt ?? property.name} {description} {canonical} image={property.photos[0] ? imageUrls.get(property.photos[0].url) : undefined} {jsonLd} {locale} alternates>
  <Page {property} config={siteConfig} {locale} />
</BaseLayout>
