---
import { fullPhoto } from '../lib/images';
import type { PropertyUnit } from '../domain/property';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
interface Props { units: PropertyUnit[]; locale: Locale }
const { units, locale } = Astro.props;
const t = useTranslations(locale);
const unitGalleries = await Promise.all(units.map(async (unit) =>
  Promise.all(unit.photos.map(async (photo) => {
    const image = await fullPhoto(photo.url);
    return { ...photo, url: image.src, width: image.attributes.width, height: image.attributes.height };
  }))
));
---
<dialog class="lightbox" id="unit-lightbox" aria-label={t('unitPhotos')} data-galleries={JSON.stringify(unitGalleries)} data-unit-names={JSON.stringify(units.map((unit) => unit.name))} data-photo-label={t('photo')}>
  <div class="lightbox-bar"><p><span id="lightbox-unit"></span> · <strong id="lightbox-current">1</strong> / <span id="lightbox-total">1</span></p><button class="lightbox-close" type="button" aria-label={t('closeGallery')}>×</button></div>
  <div class="lightbox-stage"><button class="lightbox-nav lightbox-prev" type="button" aria-label={t('previousPhoto')}>‹</button><figure><img id="lightbox-image" alt="" decoding="async" /><figcaption id="lightbox-caption"></figcaption></figure><button class="lightbox-nav lightbox-next" type="button" aria-label={t('nextPhoto')}>›</button></div>
</dialog>
<script>
  interface GalleryPhoto {
    url: string;
    width: number;
    height: number;
    alt?: string;
  }

  function initializeLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('#unit-lightbox');
    if (!dialog) return;
    const lightboxImage = dialog.querySelector<HTMLImageElement>('#lightbox-image');
    const caption = dialog.querySelector<HTMLElement>('#lightbox-caption');
    const current = dialog.querySelector<HTMLElement>('#lightbox-current');
    const total = dialog.querySelector<HTMLElement>('#lightbox-total');
    const unitName = dialog.querySelector<HTMLElement>('#lightbox-unit');
    if (!lightboxImage || !caption || !current || !total || !unitName) return;

    const galleries: GalleryPhoto[][] = JSON.parse(dialog.dataset.galleries ?? '[]');
    const names: string[] = JSON.parse(dialog.dataset.unitNames ?? '[]');
    const photoLabel = dialog.dataset.photoLabel ?? 'Photo';
    let activeUnit = 0;
    let activePhoto = 0;
    let touchStartX: number | undefined;

    function showPhoto(index: number) {
      const gallery = galleries[activeUnit];
      if (!gallery?.length || !Number.isInteger(index)) return false;
      activePhoto = ((index % gallery.length) + gallery.length) % gallery.length;
      const photo = gallery[activePhoto];
      if (!photo || !lightboxImage || !caption || !current) return false;
      lightboxImage.width = photo.width;
      lightboxImage.height = photo.height;
      lightboxImage.src = photo.url;
      lightboxImage.alt = photo.alt || `${photoLabel} ${activePhoto + 1}`;
      caption.textContent = photo.alt || '';
      current.textContent = String(activePhoto + 1);
      return true;
    }

    document.querySelectorAll<HTMLElement>('[data-unit-photo-index]').forEach((button) => {
      button.addEventListener('click', () => {
        activeUnit = Number(button.dataset.unitIndex);
        const gallery = galleries[activeUnit];
        if (!gallery?.length || !showPhoto(Number(button.dataset.unitPhotoIndex))) return;
        unitName.textContent = names[activeUnit] ?? '';
        total.textContent = String(gallery.length);
        dialog.showModal();
        document.body.classList.add('lightbox-open');
      });
    });
    dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lightbox-prev')?.addEventListener('click', () => showPhoto(activePhoto - 1));
    dialog.querySelector('.lightbox-next')?.addEventListener('click', () => showPhoto(activePhoto + 1));
    dialog.addEventListener('close', () => document.body.classList.remove('lightbox-open'));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        showPhoto(activePhoto + (event.key === 'ArrowLeft' ? -1 : 1));
      }
    });
    dialog.addEventListener('touchstart', (event) => {
      touchStartX = event.changedTouches[0]?.clientX;
    }, { passive: true });
    dialog.addEventListener('touchend', (event) => {
      const endX = event.changedTouches[0]?.clientX;
      if (touchStartX !== undefined && endX !== undefined) {
        const distance = endX - touchStartX;
        if (Math.abs(distance) > 50) showPhoto(activePhoto + (distance < 0 ? 1 : -1));
      }
      touchStartX = undefined;
    }, { passive: true });
    dialog.addEventListener('touchcancel', () => { touchStartX = undefined; }, { passive: true });
  }

  initializeLightbox();
</script>
