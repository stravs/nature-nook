---
import PropertyImage from './PropertyImage.astro';
import type { PropertyPhoto } from '../domain/property';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';

type SpacePhoto = { photo: PropertyPhoto; index: number };
interface Props { spaces: { name: string; photos: SpacePhoto[] }[]; unitIndex: number; locale: Locale }
const { spaces, unitIndex, locale } = Astro.props;
const t = useTranslations(locale);
const photoButton = 'tw:m-0 tw:block tw:aspect-[4/3] tw:min-w-0 tw:basis-full tw:shrink-0 tw:snap-start tw:cursor-zoom-in tw:overflow-hidden tw:rounded-[20px_6px] tw:border-0 tw:bg-transparent tw:p-0 tw:sm:basis-[calc((100%-1rem)/2)] tw:lg:basis-[calc((100%-2rem)/3)] tw:[&_img]:block tw:[&_img]:h-full tw:[&_img]:w-full tw:[&_img]:object-cover tw:focus-visible:outline-2 tw:focus-visible:outline-offset-4 tw:focus-visible:outline-(--clay)';
const arrowButton = 'tw:group tw:grid tw:h-12 tw:w-16 tw:place-items-center tw:rounded-full tw:border tw:border-(--moss)/25 tw:bg-transparent tw:text-(--moss) tw:cursor-pointer tw:transition-all tw:duration-200 tw:enabled:hover:border-(--moss) tw:enabled:hover:bg-(--moss) tw:enabled:hover:text-white tw:enabled:hover:shadow-md tw:enabled:active:scale-95 tw:focus-visible:outline-2 tw:focus-visible:outline-offset-4 tw:focus-visible:outline-(--clay) tw:disabled:cursor-default tw:disabled:opacity-25 tw:motion-reduce:transition-none';
---
<div class="tw:col-span-full tw:min-w-0">
  <div class="tw:grid tw:gap-6">
    {spaces.map((space, index) => (
      <article id={`space-${index + 1}`} class="tw:grid tw:min-w-0 tw:scroll-mt-28 tw:gap-6" aria-labelledby={`space-${index + 1}-title`}>
        <h3 id={`space-${index + 1}-title`} class="tw:m-0 tw:font-(family-name:--font-display) tw:text-3xl tw:leading-tight tw:font-semibold tw:lg:text-4xl">{space.name}</h3>
        <div class="tw:relative tw:grid tw:gap-6" data-space-gallery>
        <div id={`space-${unitIndex}-${index}-photos`} data-space-photo-row class="tw:flex tw:gap-4 tw:overflow-x-auto tw:snap-x tw:snap-mandatory tw:overscroll-x-contain tw:[scrollbar-width:none] tw:[&::-webkit-scrollbar]:hidden tw:lg:data-[draggable=true]:cursor-grab tw:lg:data-[draggable=true]:[&_button]:cursor-grab tw:data-[dragging=true]:cursor-grabbing tw:data-[dragging=true]:[&_button]:cursor-grabbing tw:select-none">
          {space.photos.map(({ photo, index: photoIndex }) => (
            <button type="button" data-unit-index={unitIndex} data-unit-photo-index={photoIndex} aria-label={`${t('openUnitPhotos')} ${space.name}`} class:list={[photoButton, { 'tw:[&_img]:object-bottom': /bathroom|kopalnica/i.test(space.name) }]} >
              <PropertyImage photo={photo} alt={photo.alt ?? space.name} sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 33vw" />
            </button>
          ))}
        </div>
        <div data-space-controls class="tw:flex tw:min-h-12 tw:justify-end tw:gap-3 tw:invisible">
          <button type="button" data-space-previous class={arrowButton} aria-label={t('previousPhoto')} aria-controls={`space-${unitIndex}-${index}-photos`} disabled>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6" /></svg>
          </button>
          <button type="button" data-space-next class={arrowButton} aria-label={t('nextPhoto')} aria-controls={`space-${unitIndex}-${index}-photos`} disabled>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
          </button>
        </div>
        </div>
      </article>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-space-photo-row]').forEach((row) => {
    const gallery = row.closest('[data-space-gallery]')!;
    const controls = gallery.querySelector<HTMLElement>('[data-space-controls]')!;
    const previous = gallery.querySelector<HTMLButtonElement>('[data-space-previous]')!;
    const next = gallery.querySelector<HTMLButtonElement>('[data-space-next]')!;
    const updateRow = () => {
      const maxScroll = row.scrollWidth - row.clientWidth;
      row.dataset.draggable = String(maxScroll > 1);
      controls.classList.toggle('tw:invisible', maxScroll <= 1);
      previous.disabled = row.scrollLeft <= 1;
      next.disabled = row.scrollLeft >= maxScroll - 1;
    };
    const advance = (direction: number) => {
      const photo = row.querySelector<HTMLElement>('button');
      if (!photo) return;
      row.scrollBy({
        left: direction * (photo.getBoundingClientRect().width + 16),
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      });
    };
    previous.addEventListener('click', () => advance(-1));
    next.addEventListener('click', () => advance(1));
    row.addEventListener('scroll', updateRow, { passive: true });
    row.scrollLeft = 0;
    const observer = new ResizeObserver(updateRow);
    observer.observe(row);
    updateRow();

    let startX = 0;
    let startScroll = 0;
    let pointer: number | null = null;
    let dragged = false;

    row.addEventListener('pointerdown', (event) => {
      if (window.innerWidth < 1024 || event.pointerType !== 'mouse' ||
          event.button !== 0 || row.scrollWidth <= row.clientWidth + 1) return;
      pointer = event.pointerId;
      startX = event.clientX;
      startScroll = row.scrollLeft;
      dragged = false;
    });
    row.addEventListener('pointermove', (event) => {
      if (event.pointerId !== pointer) return;
      const distance = event.clientX - startX;
      if (!dragged && Math.abs(distance) < 6) return;
      dragged = true;
      row.dataset.dragging = 'true';
      row.setPointerCapture(event.pointerId);
      row.scrollLeft = startScroll - distance;
      event.preventDefault();
    });
    const endDrag = () => {
      if (pointer !== null && row.hasPointerCapture(pointer)) row.releasePointerCapture(pointer);
      pointer = null;
      delete row.dataset.dragging;
    };
    row.addEventListener('pointerup', endDrag);
    row.addEventListener('pointercancel', endDrag);
    row.addEventListener('lostpointercapture', endDrag);
    row.addEventListener('pointerleave', () => {
      if (!dragged) endDrag();
    });
    row.addEventListener('dragstart', (event) => {
      if (window.innerWidth >= 1024) event.preventDefault();
    });
    row.addEventListener('click', (event) => {
      if (!dragged) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      dragged = false;
    }, true);
  });
</script>
