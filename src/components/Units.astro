---
import type { Property } from '../domain/property';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
import UnitCard from './UnitCard.astro';
interface Props { property: Property; locale: Locale }
const { property, locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="units-section" id="units"><div class="section tw:py-14 tw:lg:py-20">
  <div class="section-heading units-heading tw:mb-6"><div>{property.units.length > 1 && <p class="eyebrow">{t('chooseSpace')}</p>}<h2>{property.units.length === 1 ? t('accommodation') : t('units')}</h2></div>{property.units.length > 1 && <p>{t('options', { count: property.units.length })}</p>}</div>
  <div class="unit-list">{property.units.map((unit, unitIndex) => <UnitCard {unit} {unitIndex} unitCount={property.units.length} fallbackPhotos={property.photos} {locale} />)}</div>
</div></section>
