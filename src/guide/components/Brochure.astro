---
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import BrochurePage from './BrochurePage.astro';
import { guideRoot } from '../lib/guide-data';
import { wifiQrPayload } from '../lib/wifi';
import { apartment } from '../lib/guide-data';
import { bookletSheets, draft, pageCount, usableWifi, demoWifi } from '../lib/brochure';
interface Props { booklet?: boolean; }
const { booklet = false } = Astro.props;
const guideUrl = Astro.site ? new URL(guideRoot, Astro.site).href : undefined;
const qr = guideUrl ? await QRCode.toString(guideUrl, { type: 'svg', margin: 4, errorCorrectionLevel: 'M', color: { dark: '#183c2d', light: '#ffffff' } }) : undefined;
const wifiQr = (usableWifi || demoWifi) && apartment.wifi.network && apartment.wifi.password ? await QRCode.toString(wifiQrPayload(apartment.wifi.network!, apartment.wifi.password!), { type: 'svg', margin: 4, errorCorrectionLevel: 'M', color: { dark: '#183c2d', light: '#ffffff' } }) : undefined;
const sheets: readonly (readonly number[])[] = booklet ? bookletSheets : Array.from({ length: pageCount }, (_, index) => [index + 1]);
---
<Layout title={booklet ? 'Print guest booklet · A4' : 'Print guest brochure · A5'} description="A printable eight-page guest brochure for Nature nook, Bled.">
  <div data-brochure-layout={booklet ? 'booklet' : 'reading'}>
    <header class="mx-auto max-w-4xl px-5 py-8 print:hidden">
      <a href={guideRoot} class="inline-flex min-h-11 items-center font-bold underline underline-offset-4">← Back to guest guide</a>
      <h1 class="mt-4 text-4xl text-forest">A little guide, on paper.</h1>
      <p class="mt-3 max-w-2xl">Eight thoughtfully laid-out pages for your stay, with every Bled recommendation on one printable map. Choose a reading copy or a fold-and-staple booklet.</p>
      <nav aria-label="Print format" class="mt-5 flex flex-wrap gap-3">
        <a href={`${guideRoot}/print`} aria-current={!booklet ? 'page' : undefined} class="inline-flex min-h-12 items-center rounded-full border border-forest/25 px-5 font-bold aria-[current=page]:bg-forest aria-[current=page]:text-white">A5 reading copy</a>
        <a href={`${guideRoot}/print/booklet`} aria-current={booklet ? 'page' : undefined} class="inline-flex min-h-12 items-center rounded-full border border-forest/25 px-5 font-bold aria-[current=page]:bg-forest aria-[current=page]:text-white">A4 folded booklet</a>
        <button id="print-brochure" type="button" hidden class="min-h-12 items-center rounded-full bg-forest px-5 font-bold text-white">Print / Save as PDF</button>
      </nav>
      <aside class="mt-5 rounded-2xl border border-forest/20 bg-white p-5 text-base">
        <h2 class="text-xl">{booklet ? 'Print a folded booklet' : 'Print or save your reading copy'}</h2>
        <p class="mt-2">{booklet ? 'A4 paper · landscape · two-sided · flip on the short edge · actual size (100%). Pages are already arranged for folding: do not select another “booklet” or “multiple pages per sheet” option.' : 'A5 paper · portrait · actual size (100%). Save as PDF for eight pages in reading order. For home printing on A4, choose the folded booklet instead.'}</p>
        <p class="mt-2">Turn off browser headers and footers. Use no additional margins. Background graphics are optional; text and borders remain readable without them.</p>
        {booklet && <p class="mt-2">Print one test copy first. Keep sheets in output order, nest the inner sheet inside the outer sheet, fold together and staple along the fold. Printer duplex settings vary.</p>}
        <p class="mt-2 text-sm">You can also use your browser’s Print menu to print or save this brochure as a PDF. No JavaScript is required for the pages.</p>
      </aside>
      {draft && <p role="note" class="mt-4 border-l-4 border-clay pl-4 text-base font-semibold">Draft — the owner has not yet approved the stay details. The cover includes a clearly labelled demo Wi-Fi QR; replace it before sharing. Review parking, equipment, rules and safety locations before sharing with guests. Every printed page is marked as a draft.</p>}
      <p id="brochure-feedback" role="status" class="mt-3 text-base"></p>
      {booklet && <p class="mt-5 text-sm text-moss">Wide sheets scroll horizontally on smaller screens. Use the A5 reading copy for an easier preview.</p>}
    </header>
    <main id="main-content" aria-label={booklet ? `${pageCount / 2} A4 sheet sides in booklet order` : `${pageCount} A5 pages in reading order`} class="brochure-pages space-y-8 overflow-x-auto bg-sage/40 px-4 py-8 print:space-y-0 print:overflow-visible print:bg-white print:p-0">
      {sheets.map((pages, index) => <div data-brochure-sheet={index + 1} class:list={['brochure-sheet mx-auto flex w-fit gap-0', booklet && 'min-h-[210mm]']}>
        {pages.map(page => <BrochurePage page={page} qr={qr} wifiQr={wifiQr} guideUrl={guideUrl} />)}
      </div>)}
    </main>
  </div>
</Layout>
<script src="../scripts/brochure.ts"></script>
<!-- Paper dimensions, named pages and pagination require paged-media CSS. All other styling is Tailwind. -->
<style is:global>
  @page brochure-reading { size: 148mm 210mm; margin: 0; }
  @page brochure-booklet { size: A4 landscape; margin: 0; }
  @media print {
    html, body { margin: 0; padding: 0; background: white; }
    body > a[href="#main-content"] { display: none; }
    [data-brochure-layout="reading"] .brochure-sheet { page: brochure-reading; }
    [data-brochure-layout="booklet"] .brochure-sheet { page: brochure-booklet; width: 297mm; justify-content: center; }
    .brochure-sheet { break-after: page; break-inside: avoid; }
    .brochure-sheet:last-child { break-after: auto; }
    [data-brochure-page] { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  }
</style>
