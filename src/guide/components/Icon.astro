---
import { icons, type IconName } from '../lib/icons';
interface Props { name: IconName; class?: string; }
const { name, class: className = 'size-6' } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[name]} /></svg>
