---
import Icon from './Icon.astro';
import { baseFor, textFor, type Language } from '../lib/guide-data';
interface Props { app?: boolean; lang?: Language; desktop?: boolean; }
const { app = false, lang = 'en', desktop = false } = Astro.props;
const t = textFor(lang);
const base = baseFor(lang);
---
<nav aria-label={lang === 'en' ? 'Guest guide' : 'Vodnik za goste'} data-bottom-navigation={!desktop || undefined} class={desktop ? 'hidden shrink-0 lg:block print:hidden' : 'fixed inset-x-0 bottom-0 z-50 border-t border-forest/15 bg-paper px-4 pb-[max(0.5rem,env(safe-area-inset-bottom))] pt-2 lg:hidden print:hidden'}>
  <div class={desktop ? 'flex gap-1 rounded-full bg-sage p-1' : 'mx-auto grid max-w-lg grid-cols-2 gap-3'}>
    {[['stay', t.apartment, 'home'], ['map', t.recommendationsTab, 'map']].map(([id, label, icon]) => <a href={`${base}?view=${id}#${id === 'stay' ? 'stay' : 'map-view'}`} data-view={app ? id : undefined} class="flex min-h-14 min-w-0 flex-col items-center justify-center gap-1 rounded-2xl px-1 py-2 text-sm font-semibold lg:flex-row lg:gap-2 lg:rounded-full lg:px-5 lg:text-base transition-colors hover:bg-forest/10 aria-[current=page]:bg-forest aria-[current=page]:text-white"><Icon name={icon as 'home' | 'map'} class="size-5 shrink-0" /><span class="min-w-0 text-center">{label}</span></a>)}
  </div>
</nav>
