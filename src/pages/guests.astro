---
import GuestHomeBase from '../components/GuestHomeBase.astro';
import '../styles/guest-game.css';
import GuestGuideViews from '../components/GuestGuideViews.astro';
import GuestStayNav from '../components/GuestStayNav.astro';
import '../styles/guest-layout.css';
import GuestExplore from '../components/GuestExplore.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Font } from 'astro:assets';
import { localizeProperty, propertyLocation } from '../domain/property';
import { propertyRepository } from '../repositories/property-repository';
import { languageNames, localePath, locales } from '../i18n';
import { getSiteConfig } from '../config/site';

const sourceProperty = await propertyRepository.get();
if (!sourceProperty) return Astro.redirect('/setup');
const property = localizeProperty(sourceProperty, 'en');
const largestUnitCapacity = Math.max(0, ...property.units.map((unit) => unit.maxGuests ?? 0));
const location = propertyLocation(property);
const mapsUrl = property.latitude !== undefined && property.longitude !== undefined
  ? `https://www.google.com/maps/search/?api=1&query=${property.latitude},${property.longitude}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}`;
const title = `Guest guide | ${property.name}`;
const description = `Practical information for your stay at ${property.name}: arrival, departure, amenities, house rules, and booking information.`;
const sections = [['arrival', 'Arrival'], ['accommodation', 'Accommodation'], ['amenities', 'Amenities'], ['house-rules', 'House rules'], ['departure', 'Departure'], ['help', 'Help'], ['explore', 'Explore nearby']];
const config = await getSiteConfig();
const designStyle = `--ink:${config.design.colors.text};--muted:${config.design.colors.muted};--paper:${config.design.colors.background};--soft:${config.design.colors.surface};--cream:${config.design.colors.surface};--moss:${config.design.colors.primary};--clay:${config.design.colors.accent};--font-display:var(--astro-font-heading),ui-rounded,system-ui,sans-serif;--font-body:var(--astro-font-body),system-ui,sans-serif`;
---
<BaseLayout {title} {description} locale="en" alternates noindex>
  <Font slot="head" cssVariable="--astro-font-hand" />
  <div class="guest-site guest-guide-layout" data-site-slug={config.site.slug} data-edges={config.design.edges} style={designStyle}>
  <header class="guest-header">
    <div class="guest-brand"><span>Guest guide</span><a class="brand" href="/" aria-label={`${property.name} – home`}>{property.name}</a></div>
    <nav class="site-actions" aria-label="Language and navigation">
      <a class="guest-header-link" href="/">← Back to property</a>
      <span class="language-switcher">{locales.map((item) => <a href={localePath(item, 'guests')} lang={item} aria-current={item === 'en' ? 'page' : undefined} aria-label={languageNames[item]}>{item.toUpperCase()}</a>)}</span>
    </nav>
  </header>
  <div class="guest-shell">
    <main class="guest-doc">
      <GuestGuideViews locale="en" />
      <div id="stay" data-guide-panel="stay">
      <GuestHomeBase locale="en" propertyName={property.name} checkIn={property.checkIn} checkOut={property.checkOut} capacity={largestUnitCapacity} />
      <GuestStayNav locale="en" {sections} />
      <section class="doc-section" id="arrival"><div class="doc-content"><p class="eyebrow">See you soon</p><h2>Getting here</h2><p class="doc-lead">You’ll find us at <strong>{location}</strong>. We sent key collection details through your reservation messages.</p><div class="info-grid">
        <article><span class="info-icon" aria-hidden="true">↳</span><h3>Arrival time</h3><p>{property.checkIn ?? 'As agreed with your host'}</p></article>
        <article><span class="info-icon" aria-hidden="true">⌖</span><h3>Directions</h3><p>{location}</p><a href={mapsUrl} target="_blank" rel="noopener">Open in Google Maps ↗</a></article>
      </div><aside class="doc-note"><strong>Just let us know</strong><p>If you’re arriving later or your journey is delayed, send us a message and we’ll arrange your arrival together.</p></aside></div></section>
      <section class="doc-section" id="accommodation"><div class="doc-content"><p class="eyebrow">Make yourself at home</p><h2>Your space</h2><p class="doc-lead">{property.description}</p>{property.units.some((unit) => unit.rooms.length) && <div class="room-list">{property.units.flatMap((unit) => unit.rooms.map((room) => ({ ...room, unitName: property.units.length > 1 ? unit.name : undefined }))).map((room) => <article><div><h3>{room.unitName ? `${room.unitName} · ${room.name}` : room.name}</h3>{room.beds && <p>{room.beds}</p>}</div>{room.sleeps && <span>for {room.sleeps}</span>}</article>)}</div>}</div></section>
      <section class="doc-section" id="amenities"><div class="doc-content"><p class="eyebrow">Prepared for you</p><h2>Amenities and comfort</h2><p class="doc-lead">Here is what awaits you. If you can’t find something or aren’t sure how it works, please message us.</p><ul class="amenity-doc-list">{property.amenities.map((amenity) => <li><span aria-hidden="true">✓</span>{amenity}</li>)}</ul></div></section>
      <section class="doc-section" id="house-rules"><div class="doc-content"><p class="eyebrow">A few friendly requests</p><h2>Keeping it pleasant for everyone</h2><p class="doc-lead">Please look after the property as you would your own home and be considerate of our neighbours.</p><ul class="rule-list">
        <li><span>01</span><div><h3>Quiet hours: 10:00 PM–6:00 AM</h3><p>Please keep noise down during these hours so our neighbours can enjoy the peace too.</p></div></li>
        <li><span>02</span><div><h3>If something happens</h3><p>Don’t worry—just tell us promptly so we can resolve it together.</p></div></li>
        <li><span>03</span><div><h3>Registered guests</h3><p>Only guests included in the reservation may stay overnight. Contact us about special requests.</p></div></li>
      </ul></div></section>
      <section class="doc-section" id="departure"><div class="doc-content"><p class="eyebrow">Before we say goodbye</p><h2>Departure</h2><p class="doc-lead">Departure is by <strong>{property.checkOut ?? 'the agreed time'}</strong>. Key instructions are in your reservation messages.</p><div class="checklist">
        <label><input type="checkbox" /> <span>Check that you have all your belongings.</span></label><label><input type="checkbox" /> <span>Close the windows and turn off the lights.</span></label><label><input type="checkbox" /> <span>Return the keys as agreed with your host.</span></label>
      </div></div></section>
      <section class="doc-section" id="help">
        <div class="doc-content">
          <p class="eyebrow">Get in touch</p><h2>We’re here if you need us</h2>
          <p class="doc-lead">If you need anything during your stay, please contact your host. You can also reach us through your reservation messages.</p>
          {(property.contact?.phone || property.contact?.email) && <div class="contact-card">
            <div><p class="eyebrow">Your host</p><h3>{property.name}</h3></div>
            <div class="contact-links">
              {property.contact?.phone && <a href={`tel:${property.contact.phone}`}>{property.contact.phone}</a>}
              {property.contact?.email && <a href={`mailto:${property.contact.email}`}>{property.contact.email}</a>}
            </div>
          </div>}
          <h3>Useful numbers in Slovenia</h3>
          <div class="info-grid">
            <article><h3>Police</h3><p>For urgent police assistance.</p><a href="tel:113">113</a></article>
            <article><h3>Emergency services</h3><p>For urgent medical help, firefighters, or mountain rescue.</p><a href="tel:112">112</a></article>
            <article><h3>Roadside assistance · AMZS</h3><p>For a vehicle breakdown. Also available at <a href="tel:+38615305353">+386 1 530 53 53</a>.</p><a href="tel:1987">1987</a></article>
          </div>
          <h3>Taxi</h3>
          <div class="info-grid">
            <article><h3>Bled Taxi Transfer</h3><a href="tel:+38641710747">+386 41 710 747</a></article>
            <article><h3>Bled Taxi</h3><a href="tel:+38670851277">+386 70 851 277</a></article>
          </div>
        </div>
      </section>
      </div>
      <GuestExplore locale="en" propertyName={property.name} {mapsUrl} latitude={property.latitude} longitude={property.longitude} />
    </main>
  </div>
  <footer class="guest-footer"><p>© {new Date().getFullYear()} {property.name}</p><a href="#top">Back to top ↑</a></footer>
  </div>
</BaseLayout>
