{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nature-nook",
  "main": "worker/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-09-06",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
